# =============================================================================
# ProjectLens environment template
# Copy to `.env` and fill in secrets. Never commit real API keys or Feishu secrets.
# Full pilot profiles: docs/pilot-launch-config.md
# =============================================================================

PROJECT_LENS_ENV=development
PROJECT_LENS_LOG_LEVEL=INFO
PROJECT_LENS_API_PREFIX=/api/v1

# Persistent SQLite path for runs / events / conversations.
# Pilot / Feishu tests: use a real file path. Do NOT use ":memory:".
PROJECT_LENS_DATABASE_PATH=project_lens.db

# ConversationSession backend: sqlite (default, durable) | memory (tests only)
PROJECT_LENS_CONVERSATION_STORE=sqlite

# -----------------------------------------------------------------------------
# Model provider
# Defaults keep live network LLM off. Production decision path is Hermes
# (PROJECT_LENS_AGENT_MODE=hermes). ProjectLens still owns ACL, evidence,
# verification, and audit. Do NOT enable Apply / PR / deploy / rollback via env.
# -----------------------------------------------------------------------------
PROJECT_LENS_MODEL_PROVIDER=stub
PROJECT_LENS_MODEL_NAME=stub-v1
PROJECT_LENS_MODEL_TIMEOUT_SECONDS=30
PROJECT_LENS_MODEL_MAX_RETRIES=1
PROJECT_LENS_MODEL_MAX_TOKENS=2048
PROJECT_LENS_MODEL_TEMPERATURE=0.0

# Safe Live: both provider=openai AND live=true required for real network calls.
PROJECT_LENS_MODEL_LIVE=false
PROJECT_LENS_MODEL_FALLBACK_TO_STUB=true

# OpenAI-compatible provider (only when greying in Safe Live)
PROJECT_LENS_MODEL_OPENAI_BASE_URL=
PROJECT_LENS_MODEL_OPENAI_MODEL=gpt-4o-mini
PROJECT_LENS_MODEL_OPENAI_API_KEY=

# Reserved providers (not required for V0.1–V0.3 pilot)
PROJECT_LENS_MODEL_INTERNAL_ENDPOINT=
PROJECT_LENS_MODEL_LOCAL_PATH=

# Optional semantic memory retrieval.
# Knowledge retrieval below can reuse this OpenAI-compatible embedding provider.
PROJECT_LENS_EMBEDDING_PROVIDER=none
PROJECT_LENS_EMBEDDING_MODEL=text-embedding-3-small
PROJECT_LENS_EMBEDDING_API_KEY=
PROJECT_LENS_EMBEDDING_BASE_URL=
PROJECT_LENS_EMBEDDING_TIMEOUT_SECONDS=10

# Knowledge retrieval. Keep lexical for a safe local default; enable hybrid only
# after the embedding endpoint and credentials have been configured.
PROJECT_LENS_KNOWLEDGE_RETRIEVAL_MODE=lexical
PROJECT_LENS_KNOWLEDGE_VECTOR_ENABLED=false
PROJECT_LENS_KNOWLEDGE_EMBEDDING_MODEL=
PROJECT_LENS_KNOWLEDGE_EMBEDDING_VERSION=
PROJECT_LENS_KNOWLEDGE_CHUNKER_VERSION=v1
PROJECT_LENS_KNOWLEDGE_MAX_CANDIDATES=200
PROJECT_LENS_KNOWLEDGE_MAX_RESULTS=8
PROJECT_LENS_KNOWLEDGE_VECTOR_TIMEOUT_SECONDS=10
PROJECT_LENS_KNOWLEDGE_VECTOR_FALLBACK=true

# -----------------------------------------------------------------------------
# Agent execution mode
# Hermes is the only production decision runtime. ProjectLens still owns
# identity/scope binding, tool authorization, evidence verification, and audit.
# -----------------------------------------------------------------------------
PROJECT_LENS_AGENT_MODE=hermes
# Legacy ProjectSkill routing / followup / card branching (paused by default).
PROJECT_LENS_PROJECT_SKILL_ROUTING_ENABLED=false
PROJECT_LENS_FEISHU_HERMES_ADVANCED_TOOLS=false
PROJECT_LENS_FEISHU_HERMES_RISK_REVIEW_ENABLED=false
PROJECT_LENS_FEISHU_HERMES_RISK_REVIEW_INTERVAL_SECONDS=0
PROJECT_LENS_FEISHU_HERMES_EXECUTION_ENABLED=false
PROJECT_LENS_FEISHU_HERMES_LOOP_TIMEOUT_SECONDS=120

# Required in pilot/production for project-agent and Hermes internal APIs.
PROJECT_LENS_SERVICE_TOKEN=
# MCP stdio identity. Leave blank to fail closed for MCP asks/tools.
PROJECT_LENS_MCP_TRUSTED_TENANT_ID=
PROJECT_LENS_MCP_TRUSTED_ACTOR_ID=
PROJECT_LENS_MCP_TRUSTED_CHAT_ID=
PROJECT_LENS_MCP_TRUSTED_CHAT_TYPE=group
# Absolute path to your Hermes agent checkout (used by start-hermes script).
PROJECT_LENS_HERMES_REPO=
PROJECT_LENS_FEISHU_HERMES_PROVIDER=openai
PROJECT_LENS_FEISHU_HERMES_MODEL=gpt-5.4-mini
# Optional overrides. Empty values reuse MODEL_OPENAI_BASE_URL/API_KEY.
PROJECT_LENS_FEISHU_HERMES_BASE_URL=
PROJECT_LENS_FEISHU_HERMES_API_KEY=

# -----------------------------------------------------------------------------
# Feishu callback + outbound API
# Leave APP_ID / APP_SECRET blank to use the local recording messenger.
# -----------------------------------------------------------------------------
PROJECT_LENS_FEISHU_VERIFICATION_TOKEN=replace-me
PROJECT_LENS_FEISHU_SIGNING_SECRET=
PROJECT_LENS_FEISHU_APP_ID=
PROJECT_LENS_FEISHU_APP_SECRET=
PROJECT_LENS_FEISHU_API_BASE_URL=https://open.feishu.cn
PROJECT_LENS_FEISHU_VIRTUAL_MEMBERS_ENABLED=false
PROJECT_LENS_FEISHU_VIRTUAL_MEMBER_OPERATORS=
PROJECT_LENS_FEISHU_VIRTUAL_MEMBER_PROFILES=
PROJECT_LENS_FEISHU_VIRTUAL_MEMBERS_ENABLED=false
PROJECT_LENS_FEISHU_VIRTUAL_MEMBER_OPERATORS=
PROJECT_LENS_FEISHU_VIRTUAL_MEMBER_PROFILES=
# Context preview card before answering. Set false to skip and answer immediately.
PROJECT_LENS_FEISHU_CONTEXT_PREVIEW_ENABLED=false
PROJECT_LENS_FEISHU_WIKI_PUBLISH_ENABLED=false
PROJECT_LENS_FEISHU_WIKI_SPACE_ID=
PROJECT_LENS_FEISHU_WIKI_PARENT_NODE_TOKEN=
PROJECT_LENS_GITHUB_API_BASE_URL=https://api.github.com
# Optional read-only GitHub token. Leave empty for public repositories.
PROJECT_LENS_GITHUB_TOKEN=

# Optional Feishu document sync ops (default off; does not affect chat paths)
PROJECT_LENS_FEISHU_DOC_SYNC_ON_STARTUP=false
PROJECT_LENS_FEISHU_DOC_SYNC_INTERVAL_SECONDS=0

# -----------------------------------------------------------------------------
# Local project registry (demo payment_service)
# Paths can be absolute or relative to the ProjectLens project root.
# -----------------------------------------------------------------------------
PROJECT_LENS_LOCAL_PROJECT_REGISTRY={"projects":[{"tenant_id":"demo","project_id":"payment","service":"order-service","environment":"production","repository_root":"examples/payment_service/src","documents_root":"examples/payment_service/knowledge","incidents_file":"examples/payment_service/knowledge/incidents.json","git_log_file":"examples/payment_service/fixtures/git_log.txt","git_branch":"main","feishu_documents_file":"examples/payment_service/knowledge/feishu_docs.json","feishu_doc_tokens":["docx_payment_owners"],"tasks_file":"examples/payment_service/knowledge/tasks.json","releases_file":"examples/payment_service/knowledge/releases.json","dependencies_file":"examples/payment_service/knowledge/dependencies.json","ops_signals_file":"examples/payment_service/fixtures/ops_signals.json","access_scope":"project:payment:read"}]}

# JSON binding between Feishu tenant/chat and a registered ProjectLens project.
# A binding must identify exactly one registered project. Optional allowed_users limits who can ask.
PROJECT_LENS_FEISHU_PROJECT_BINDINGS={"bindings":[{"tenant_key":"tenant-key","chat_id":"oc_xxx","project_id":"payment","service":"order-service","environment":"production"}]}
# Optional owner_mappings inside a binding map internal owner IDs to Feishu open_id for digest private messages.
# Example: {"bindings":[{"tenant_key":"tenant-key","chat_id":"oc_xxx","project_id":"payment","owner_mappings":{"u_manager":"ou_xxx"}}]}
PROJECT_LENS_FEISHU_KNOWLEDGE_GAP_DIGEST_ENABLED=false
PROJECT_LENS_FEISHU_KNOWLEDGE_GAP_DIGEST_INTERVAL_SECONDS=86400
PROJECT_LENS_FEISHU_KNOWLEDGE_GAP_DIGEST_TIMEZONE=Asia/Shanghai
